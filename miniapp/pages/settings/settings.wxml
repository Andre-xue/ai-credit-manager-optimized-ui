<view class="container ui-{{uiTheme}}">
  <view class="banner">🔒 所有设置与数据均保存在本机，不会上传。清空数据前请先导出备份。</view>

  <view class="card">
    <view class="section-title">界面外观</view>
    <view class="theme-block">
      <view class="theme-heading {{themeExpanded ? '' : 'collapsed'}}" bindtap="toggleThemePanel" hover-class="theme-heading-hover">
        <text class="theme-heading-text">八套全平台主题</text>
        <view class="theme-heading-actions">
          <text class="theme-current">当前 · {{uiThemeName}}</text>
          <text class="theme-expand-label">{{themeExpanded ? '收起' : '展开'}} {{themeExpanded ? '▴' : '▾'}}</text>
        </view>
      </view>
      <view wx:if="{{themeExpanded}}" class="theme-panel">
        <view class="theme-sub">点击即时切换，选择只保存在本机，不影响账户、额度与用量数据。</view>
        <view class="theme-grid">
          <view wx:for="{{themes}}" wx:key="id" class="theme-item {{uiTheme === item.id ? 'active' : ''}}"
                data-id="{{item.id}}" bindtap="onSelectTheme">
            <view class="theme-swatch sw-{{item.id}}">
              <view class="theme-swatch-side"></view>
              <view class="theme-swatch-main">
                <view class="sw-bar"></view><view class="sw-bar"></view><view class="sw-bar"></view>
              </view>
              <view class="theme-swatch-glow"></view>
            </view>
            <view class="theme-item-title">
              <text>{{item.letter}} · {{item.name}}</text>
              <text class="theme-tick" wx:if="{{uiTheme === item.id}}">✓</text>
            </view>
            <text class="theme-item-desc">{{item.desc}}</text>
            <text class="theme-item-interaction">{{item.interaction}}</text>
          </view>
        </view>
        <view class="theme-note">暗夜指挥舱、极光琉璃与星舰 HUD 使用固定深色画布；切换会同步更新导航栏与底部标签栏配色，并与其他端共用同一组主题名称。</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">通用</view>
    <view class="row between setting-row">
      <view>
        <view style="font-size:27rpx">签到提醒</view>
        <view class="hint" style="margin-top:6rpx">在看板显示今日待签到数量</view>
      </view>
      <switch checked="{{settings.checkinReminder}}" bindchange="onToggleReminder" color="{{themePrimary}}" />
    </view>
    <view class="row between setting-row">
      <view>
        <view style="font-size:27rpx">耗尽预警阈值</view>
        <view class="hint" style="margin-top:6rpx">剩余天数不超过阈值时提示</view>
      </view>
      <picker mode="selector" range="{{alertDaysOptions}}" value="{{alertDaysIndex}}" bindchange="onAlertDays">
        <view class="btn">{{settings.alertDays}} 天 ▾</view>
      </picker>
    </view>
    <view class="row between setting-row">
      <view>
        <view style="font-size:27rpx">默认额度单位</view>
        <view class="hint" style="margin-top:6rpx">新账户录入时的预选单位</view>
      </view>
      <picker mode="selector" range="{{unitOptions}}" range-key="label" value="{{unitIndex}}" bindchange="onUnit">
        <view class="btn">{{settings.defaultUnit === 'credit' ? '积分' : settings.defaultUnit === 'token' ? 'Tokens' : settings.defaultUnit === 'request' ? '次' : settings.defaultUnit === 'currency' ? '元' : '天'}} ▾</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="section-title">预算与费用</view>
    <view class="row between setting-row">
      <view>
        <view style="font-size:27rpx">每月预算（元）</view>
        <view class="hint" style="margin-top:6rpx">用于费用追踪与预警</view>
      </view>
      <input class="budget-input" type="number" value="{{settings.monthlyBudget}}" bindinput="onBudget" />
    </view>
    <view class="row between setting-row" bindtap="goUsage">
      <view>
        <view style="font-size:27rpx">用量统计</view>
        <view class="hint" style="margin-top:6rpx">本月费用、Tokens 与按平台消费，可手动记一笔</view>
      </view>
      <view class="btn">查看 ›</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">数据管理</view>
    <view class="row between setting-row">
      <view>
        <view style="font-size:27rpx">导出备份</view>
        <view class="hint" style="margin-top:6rpx">复制 JSON 数据到剪贴板</view>
      </view>
      <view class="btn" bindtap="exportData">导出</view>
    </view>
    <view class="row between setting-row">
      <view>
        <view style="font-size:27rpx">备份提醒</view>
        <view class="hint" style="margin-top:6rpx">长期未备份时提示</view>
      </view>
      <switch checked="{{settings.backupReminder}}" bindchange="onToggleBackup" color="{{themePrimary}}" />
    </view>
    <view class="row between setting-row">
      <view>
        <view style="font-size:27rpx">清空业务数据</view>
        <view class="hint" style="margin-top:6rpx">删除账户/额度/签到/用量，保留设置</view>
      </view>
      <view class="btn" style="color:var(--red)" bindtap="requestClear">清空</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">数据概览</view>
    <view class="row between kv"><text class="hint">账户</text><text>{{stats.accounts}} 个</text></view>
    <view class="row between kv"><text class="hint">额度快照</text><text>{{stats.quotas}} 条</text></view>
    <view class="row between kv"><text class="hint">签到记录</text><text>{{stats.checkins}} 条</text></view>
  </view>

  <view class="card">
    <view class="section-title">关于</view>
    <view class="row between kv"><text class="hint">版本</text><text>v0.1.0</text></view>
    <view class="hint" style="margin-top:16rpx;line-height:1.6">本工具不模拟登录、不自动领取、不抓取私有接口。签到仅提醒并跳转官方页面，由你本人完成。</view>
  </view>

  <view class="mask" wx:if="{{showClearConfirm}}" bindtap="cancelClear">
    <view class="confirm" catchtap="noop">
      <view class="title">确认清空</view>
      <view class="hint" style="margin:20rpx 0">将删除全部账户、额度、签到与用量记录，不可恢复。设置会保留。</view>
      <view class="row" style="gap:16rpx;align-items:center">
        <hold-btn title="清空数据" bindconfirm="confirmClear" />
        <view style="font-size:24rpx;color:var(--text-3)">长按红圈 1 秒确认清空</view>
        <view class="btn" style="flex:1" bindtap="cancelClear">取消</view>
      </view>
    </view>
  </view>
</view>
