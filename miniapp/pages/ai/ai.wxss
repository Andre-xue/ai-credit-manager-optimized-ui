.ai-page { min-height: 100vh; background: var(--bg); padding: 40rpx 32rpx 48rpx; box-sizing: border-box; display: flex; flex-direction: column; }
.state-tip { text-align: center; color: var(--text-3); font-size: 27rpx; padding-top: 200rpx; }
.hero { text-align: center; margin: 30rpx 0 50rpx; }
.mark {
  width: 130rpx; height: 130rpx; margin: 0 auto 32rpx; border-radius: 44rpx;
  background: linear-gradient(135deg, var(--grad-a), var(--grad-b) 55%, var(--grad-c)); color: #fff;
  font-size: 66rpx; line-height: 130rpx; text-align: center;
  box-shadow: 0 18rpx 48rpx rgba(147,51,234,.32);
}
.title { font-size: 42rpx; font-weight: 650; color: var(--text); }
.sub { font-size: 25rpx; color: var(--text-3); margin-top: 16rpx; line-height: 1.6; }
.section-label { font-size: 24rpx; color: var(--text-3); margin-bottom: 20rpx; }
.quick-grid { display: flex; flex-direction: column; gap: 18rpx; }
.quick-card {
  background: var(--panel); border: 1rpx solid var(--border); border-radius: 36rpx;
  padding: 30rpx 32rpx; display: flex; align-items: center; gap: 20rpx;
}
.quick-icon { font-size: 38rpx; }
.quick-title { font-size: 27rpx; color: var(--text); }

/* ---------- 登录 ---------- */
.login-card { background: var(--panel); border: 1rpx solid var(--border); border-radius: 36rpx; padding: 36rpx 32rpx; }
.method-tabs { display: flex; gap: 14rpx; margin-bottom: 30rpx; }
.method-tab {
  flex: 1; text-align: center; padding: 18rpx 0; font-size: 27rpx; color: var(--text-2);
  background: var(--bg); border: 1rpx solid var(--border); border-radius: 20rpx;
}
.method-tab.active { color: var(--primary); border-color: var(--primary); background: var(--primary-soft); font-weight: 600; }
.field {
  background: var(--bg); border: 1rpx solid var(--border); border-radius: 20rpx;
  padding: 22rpx 24rpx; font-size: 28rpx; color: var(--text); margin-bottom: 20rpx;
}
.code-row { display: flex; gap: 16rpx; }
.code-input { flex: 1; }
.code-btn {
  padding: 22rpx 26rpx; font-size: 26rpx; color: var(--primary); white-space: nowrap;
  background: var(--primary-soft); border-radius: 20rpx; text-align: center;
}
.code-btn.disabled { opacity: .5; }
.primary-btn {
  margin-top: 10rpx; background: linear-gradient(135deg, var(--grad-a), var(--grad-b)); color: #fff;
  font-size: 29rpx; font-weight: 600; text-align: center; padding: 24rpx; border-radius: 999rpx;
}
.primary-btn.disabled { opacity: .6; }
.login-note { font-size: 23rpx; color: var(--text-3); line-height: 1.6; margin-top: 20rpx; }
.login-err { font-size: 25rpx; color: #dc2626; line-height: 1.6; margin-top: 20rpx; }

/* ---------- 聊天 ---------- */
.chat-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.model-btn {
  display: flex; align-items: center; gap: 10rpx; max-width: 62%;
  background: var(--panel); border: 1rpx solid var(--border); border-radius: 999rpx; padding: 16rpx 26rpx;
}
.model-name { font-size: 27rpx; color: var(--text); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-caret { font-size: 22rpx; color: var(--text-3); }
.head-actions { display: flex; gap: 26rpx; }
.head-link { font-size: 25rpx; color: var(--text-3); }
.chat-scroll { flex: 1; min-height: 0; }
.chat-empty { padding-top: 10rpx; }
.msg-row { display: flex; margin-bottom: 22rpx; }
.msg-row.me { justify-content: flex-end; }
.msg-row.bot { justify-content: flex-start; }
.bubble {
  max-width: 82%; padding: 24rpx 28rpx; border-radius: 32rpx;
  font-size: 28rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-word;
}
.bubble.me { background: linear-gradient(135deg, var(--grad-a), var(--grad-b)); color: #fff; border-bottom-right-radius: 10rpx; }
.bubble.bot { background: var(--panel); border: 1rpx solid var(--border); color: var(--text); border-bottom-left-radius: 10rpx; }
.thinking { color: var(--text-3); }
.chat-bottom-anchor { height: 8rpx; }
.composer { display: flex; gap: 16rpx; align-items: center; padding-top: 20rpx; }
.composer-input {
  flex: 1; background: var(--panel); border: 1rpx solid var(--border); border-radius: 999rpx;
  padding: 22rpx 30rpx; font-size: 28rpx; color: var(--text);
}
.send-btn {
  background: linear-gradient(135deg, var(--grad-a), var(--grad-b)); color: #fff; font-size: 27rpx; font-weight: 600;
  padding: 22rpx 36rpx; border-radius: 999rpx; white-space: nowrap;
}
.send-btn.disabled { opacity: .55; }

/* ---------- 模型选择面板 ---------- */
.sheet-mask { position: fixed; inset: 0; background: rgba(15,23,42,.45); z-index: 50; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: var(--panel); border-radius: 36rpx 36rpx 0 0; padding: 34rpx 32rpx 50rpx; box-sizing: border-box; }
.sheet-title { font-size: 31rpx; font-weight: 650; color: var(--text); margin-bottom: 20rpx; }
.sheet-list { max-height: 56vh; }
.model-item {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 24rpx 8rpx; border-bottom: 1rpx solid var(--border);
}
.model-item.active .model-item-name { color: var(--primary); }
.model-item-name { font-size: 28rpx; color: var(--text); font-weight: 550; }
.model-item-sub { font-size: 23rpx; color: var(--text-3); margin-top: 6rpx; }
.model-check { color: var(--primary); font-size: 30rpx; font-weight: 700; }
