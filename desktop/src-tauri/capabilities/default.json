{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AI 积分管家主窗口权限",
  "windows": ["main", "mini"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope-appdata",
      "allow": ["$APPDATA/**"]
    },
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "notification:default"
  ]
}
